# Copy to .env and fill in the three REQUIRED values. Never commit .env (it is git-ignored).
# `make judge` needs nothing else: storage, URLs and the renderer are set by docker-compose.judge.yml.

# REQUIRED: your own Meta AI API key (Muse Spark, Muse Image, SAM 3.1, Voice Transcribe).
MODEL_API_KEY=
# REQUIRED: any passcode you choose; you type it on the sign-in page.
DEMO_PASSCODE=
# REQUIRED: at least 32 bytes of random text. Make one with:  openssl rand -hex 32
SESSION_SECRET=

# ---------------------------------------------------------------------------------------------
# Optional below. Only needed outside the judge stack (plain docker-compose.yml, or the server).
# ---------------------------------------------------------------------------------------------

# Media store: s3 (Amazon S3: S3_BUCKET in AWS_REGION, AWS_PROFILE or the instance role), r2
# (Cloudflare R2: the R2_* keys) or local (any S3-compatible server on this machine: the LOCAL_S3_*
# keys; the judge stack runs SeaweedFS and sets these itself).
STORAGE_PROVIDER=s3
AWS_REGION=
AWS_PROFILE=
S3_BUCKET=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
LOCAL_S3_ENDPOINT=
LOCAL_S3_PUBLIC_URL=
LOCAL_S3_BUCKET=
LOCAL_S3_ACCESS_KEY=
LOCAL_S3_SECRET_KEY=

DATABASE_URL=sqlite://data/nimbytes.db
DATA_DIR=./data
PUBLIC_BASE_URL=https://localhost
PE_MODEL_DIR=./api/models/pe
RENDERER_URL=http://localhost:3001
# Port of the judge stack (http://localhost:<port>). Default 8080.
NIMBYTES_PORT=
# Optional: https link to the Mac app's download page, shown in PWA Settings on desktop browsers.
VITE_MAC_DOWNLOAD_URL=
# 1 = at start, rerun every finished faces job once so older clips get face boxes for the privacy
# blur (SAM answers are cached, so no model cost). Leave 0; set it for one start, then back.
FACE_BOXES_BACKFILL=0
# Background job tasks (1-8). Unset = 2, one per vCPU of a 2-vCPU server; raise it on a bigger machine.
WORKERS=
# iGuide voice: MMS-TTS ONNX directory (model.onnx, vocab.json, tokenizer_config.json, meta.json).
# Optional; unset = guide steps have no voice and the server still starts.
TTS_MODEL_DIR=./api/models/mms-tts-eng
