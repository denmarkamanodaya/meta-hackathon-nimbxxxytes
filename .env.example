# Copy to .env and fill in. Never commit .env.
MODEL_API_KEY=
AWS_REGION=ap-southeast-2
AWS_PROFILE=
S3_BUCKET=
# Media store: s3 (default; S3_BUCKET in AWS_REGION, AWS_PROFILE or the instance role) or r2
# (Cloudflare R2: R2_BUCKET with the R2 keys below). Going back is one STORAGE_PROVIDER change.
STORAGE_PROVIDER=s3
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
DATABASE_URL=sqlite://data/nimbytes.db
DATA_DIR=./data
PUBLIC_BASE_URL=https://localhost
DEMO_PASSCODE=
SESSION_SECRET=
PE_MODEL_DIR=./api/models/pe
RENDERER_URL=http://localhost:3001
# Optional: https link to the Mac app's download page, shown in PWA Settings on desktop browsers.
VITE_MAC_DOWNLOAD_URL=
# 1 = at start, rerun every finished faces job once so older clips get face boxes for the privacy
# blur (SAM answers are cached, so no model cost). Leave 0; set it for one start, then back.
FACE_BOXES_BACKFILL=0
# Background job tasks (1-8). Unset = 2, one per vCPU of the 2-vCPU server; raise it on a bigger machine.
WORKERS=
# MyWay guides: MMS-TTS ONNX directory (model.onnx, vocab.json, tokenizer_config.json, meta.json).
# Optional; unset = guide steps have no voice and the server still starts.
TTS_MODEL_DIR=./api/models/mms-tts-eng
