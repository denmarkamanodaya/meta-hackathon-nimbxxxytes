# nimbytes for Mac: build-time settings. Names only; real values stay in your shell, never in git.

# The release build's fixed server (dev builds always use https://localhost).
NIMBYTES_SERVER_URL=

# Developer ID Application identity used to sign the app and the DMG, as Keychain lists it:
#   security find-identity -v -p codesigning
APPLE_SIGNING_IDENTITY=

# Dev builds only: PEM path of the local Caddy root CA (make desktop-dev sets it).
NIMBYTES_DEV_CA=
