{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nimbytes",
  "version": "2.0.3",
  "identifier": "dev.denmarkamanodaya.nimbytes",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm --prefix ../web run build:desktop"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "nimbytes",
        "width": 1280,
        "height": 820,
        "minWidth": 1200,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/nimbytes/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Video",
    "shortDescription": "Your glasses footage as a local folder",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true
    }
  }
}
