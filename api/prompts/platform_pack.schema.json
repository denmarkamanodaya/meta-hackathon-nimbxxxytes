{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "platform_pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["packs"],
  "properties": {
    "packs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "caption", "hashtags"],
        "properties": {
          "platform": { "type": "string", "enum": ["tiktok", "reels", "shorts", "feed"] },
          "caption": { "type": "string", "minLength": 1, "maxLength": 2200 },
          "hashtags": {
            "type": "array",
            "minItems": 3,
            "maxItems": 8,
            "items": { "type": "string", "minLength": 1, "maxLength": 40 }
          }
        }
      }
    }
  }
}
