{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "shot_list",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "shots"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 48 },
    "shots": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["act", "title", "direction", "tips", "query", "duration_s"],
        "properties": {
          "act": { "type": "string", "enum": ["hook", "story", "payoff", "outro"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 60 },
          "direction": { "type": "string", "minLength": 1, "maxLength": 200 },
          "tips": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": { "type": "string", "minLength": 1, "maxLength": 120 }
          },
          "query": { "type": "string", "minLength": 1, "maxLength": 120 },
          "duration_s": { "type": "number", "minimum": 1, "maximum": 20 }
        }
      }
    }
  }
}
