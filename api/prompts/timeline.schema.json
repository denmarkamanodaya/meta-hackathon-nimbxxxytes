{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "timeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["aspect", "target_seconds", "clips", "captions", "post", "rationale", "revision"],
  "properties": {
    "aspect": { "type": "string", "enum": ["4:5", "1:1"] },
    "target_seconds": { "type": "number", "minimum": 3, "maximum": 90 },
    "clips": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_id", "in", "out", "subject", "punch_in", "reason"],
        "properties": {
          "segment_id": { "type": "string", "minLength": 1 },
          "in": { "type": "number", "minimum": 0 },
          "out": { "type": "number", "minimum": 0 },
          "subject": { "type": ["string", "null"], "maxLength": 60 },
          "punch_in": { "type": "number", "minimum": 1, "maximum": 1.5 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "source"],
      "properties": {
        "style": { "type": "string", "enum": ["phrase", "none"] },
        "source": { "type": "string", "enum": ["transcript"] }
      }
    },
    "post": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caption", "hashtags"],
      "properties": {
        "caption": { "type": "string", "minLength": 1, "maxLength": 150 },
        "hashtags": {
          "type": "array",
          "maxItems": 5,
          "items": { "type": "string", "pattern": "^#[a-z0-9_]{1,30}$" }
        }
      }
    },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 200 },
    "revision": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["from_version", "changes"],
          "properties": {
            "from_version": { "type": "integer", "minimum": 1 },
            "changes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["action", "detail", "why", "note_index"],
                "properties": {
                  "action": { "type": "string", "enum": ["add", "remove", "swap", "trim", "reorder", "retime_captions"] },
                  "detail": { "type": "string", "minLength": 1, "maxLength": 80 },
                  "why": { "type": "string", "minLength": 1, "maxLength": 120 },
                  "note_index": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      ]
    }
  }
}
