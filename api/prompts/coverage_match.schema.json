{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "coverage_match",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shot", "segment_id", "reason", "take_count"],
        "properties": {
          "shot": { "type": "integer", "minimum": 1, "maximum": 12 },
          "segment_id": { "type": ["string", "null"] },
          "reason": { "type": "string", "maxLength": 160 },
          "take_count": { "type": "integer", "minimum": 0, "maximum": 8 }
        }
      }
    }
  }
}
