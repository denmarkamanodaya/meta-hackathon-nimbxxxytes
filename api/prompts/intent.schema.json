{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "title",
    "query",
    "source",
    "project_id",
    "new_project_name",
    "clip_ids",
    "target_s",
    "aspect",
    "choices",
    "document_ids",
    "question",
    "person_name",
    "viewer_name"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "search",
        "upload",
        "make_short",
        "make_guide",
        "add_to_project",
        "read_document",
        "memory_lane",
        "unclear"
      ]
    },
    "title": { "type": "string" },
    "query": {
      "type": ["string", "null"],
      "description": "search: the words to look for. make_short from a search: what the moments show. make_short from a project: the topic within it, or null for the whole project."
    },
    "source": { "type": ["string", "null"], "enum": ["attached", "project", "search", null] },
    "project_id": { "type": ["string", "null"] },
    "new_project_name": { "type": ["string", "null"] },
    "clip_ids": { "type": "array", "items": { "type": "string" } },
    "target_s": { "type": ["number", "null"] },
    "aspect": { "type": ["string", "null"], "enum": ["4:5", "1:1", null] },
    "document_ids": { "type": "array", "items": { "type": "string" } },
    "question": { "type": ["string", "null"] },
    "person_name": { "type": ["string", "null"] },
    "viewer_name": { "type": ["string", "null"] },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "text"],
        "properties": {
          "label": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    }
  }
}
