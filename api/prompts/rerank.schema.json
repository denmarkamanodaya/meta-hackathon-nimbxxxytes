{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rerank",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_id", "reason"],
        "properties": {
          "segment_id": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 90 }
        }
      }
    }
  }
}
