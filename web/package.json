{
  "name": "nimbytes-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "dev:desktop-mock": "vite --mode desktop-mock --port 5176",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "tsc --noEmit && vite build --mode desktop",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@remotion/player": "4.0.539",
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
