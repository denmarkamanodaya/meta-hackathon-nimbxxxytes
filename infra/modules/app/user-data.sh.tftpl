#!/bin/bash
# First-boot setup: Docker + Compose plugin, data volume at ${data_dir}, app directory for deploys.
set -euo pipefail

dnf install -y docker rsync
systemctl enable --now docker
usermod -aG docker ec2-user

# Docker Compose plugin, pinned and checksum-verified.
plugin_dir=/usr/local/lib/docker/cli-plugins
mkdir -p "$plugin_dir"
curl -fsSL -o "$plugin_dir/docker-compose" \
  "https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-aarch64"
echo "${compose_sha256}  $plugin_dir/docker-compose" | sha256sum -c -
chmod 0755 "$plugin_dir/docker-compose"

# The data volume is attached after boot starts; wait for its NVMe device.
device="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${data_volume_serial}"
for _ in $(seq 1 60); do
  [ -e "$device" ] && break
  sleep 5
done
[ -e "$device" ] || { echo "data volume ${data_volume_serial} never appeared" >&2; exit 1; }

# Format only a blank volume, so a replaced instance keeps the existing data.
if ! blkid "$device" >/dev/null 2>&1; then
  # XFS labels are at most 12 characters.
  mkfs.xfs -L nbdata "$device"
fi

mkdir -p "${app_dir}" "${data_dir}"
uuid="$(blkid -s UUID -o value "$device")"
grep -q "$uuid" /etc/fstab || echo "UUID=$uuid ${data_dir} xfs defaults,nofail 0 2" >> /etc/fstab
mount -a

chown ec2-user:ec2-user "${app_dir}"
chown ${app_uid}:${app_uid} "${data_dir}"
