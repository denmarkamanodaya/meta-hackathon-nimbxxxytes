{
  "name": "nimbytes-demo-video",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "assets": "node --experimental-strip-types scripts/scan-assets.ts",
    "dev": "npm run assets && remotion studio src/index.ts",
    "render": "npm run assets && remotion render src/index.ts NimbytesPromo out/nimbytes-promo.mp4 --codec=h264 --crf=18 --x264-preset=veryfast --audio-codec=aac --audio-bitrate=192k --port=3150",
    "stills": "npm run assets && node --experimental-strip-types scripts/stills.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.538",
    "@remotion/google-fonts": "4.0.538",
    "@remotion/player": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "lucide-react": "1.56.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.538",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
